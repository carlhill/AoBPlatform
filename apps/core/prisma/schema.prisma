// Core application schema (Postgres schema `core`).
//
// Rules encoded at this layer, with matching DB constraints/triggers in the
// migrations:
//  - There is NO Medicare-number column anywhere (HARD-03).
//  - Agreement anchor columns are immutable via trigger (HARD-01).
//  - Practice-scoped tables carry practiceId and are protected by RLS
//    policies with FORCE ROW LEVEL SECURITY (fail closed) — see the
//    enable_rls migration.
//  - Particulars are a snapshot (JSON) taken at lock time; the person is
//    cached, the agreement is snapshotted (REQ-DATA-10/-11).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Practice {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  abn                String?
  pms                String   @default("medtech_evolution")
  rails              String[] @default([]) // tyro | hicaps
  /**
   * Drives the public-holiday calendar for 2-business-day terminations (REQ-OFF-03).
   */
  state              String   @default("NSW")
  // FR-1.4 configuration (defaults stand until the console exposes them)
  identifierTypes    String[] @default(["name", "date_of_birth", "address"]) // floor 3, Medicare excluded non-configurably
  linkExpiryHours    Int      @default(48) // D-05 default
  channelsEnabled    String[] @default(["in_practice", "sms_link", "email_link", "paper"])
  /**
   * D6a WHEN THE PMS SUPPLIED NO APPOINTMENT TYPE (CONSULTATION-CAPTURE-PLAN
   * §2.4). One of the current `service-descriptions` content list, applied to
   * every pre-agreement the appointment sweep drafts, so most drafts never
   * reach the kiosk missing the particular that C6 blocks on.
   *
   * NULL IS THE HONEST DEFAULT and stays the default. Guessing "General
   * practitioner attendance" for a practice that has not said so would put a
   * word the practice never chose onto a contract — the platform asserting a
   * particular nobody declared. Unset means the draft arrives without D6a and
   * a person sets it, which is slower and true.
   */
  defaultServiceDescription String?
  /**
   * THE KIOSK BUILD FLOOR — staged rollout with instant rollback (TODO.md
   * "Zero-footprint kiosk").
   *
   * The zero-footprint decision only holds if a rollback REACHES a tablet
   * whose tab has been open since eight in the morning. Every kiosk request
   * carries the build it is running; when it is below this string the server
   * answers `reload: true` and the tab hard-reloads onto whatever the cloud is
   * now serving. Per practice, because rollout is per practice.
   *
   * NULL MEANS NO FLOOR, and no tablet reloads. The absence of a setting is
   * never a reason to restart every tablet in the country.
   */
  minimumKioskBuild  String?
  // Go-live gates (FR-1.7). Both flip via real integrations later; explicit
  // booleans so the checklist is honest, never inferred.
  writeBackProven    Boolean  @default(false)
  senderIdRegistered Boolean  @default(false)
  createdAt          DateTime @default(now())

  // --- Organisation registration (FR-1.1, ORG-MODEL-PROPOSAL.md §4) ---
  // Practice IS the "organisation" of that model: the ABN-bearing registered
  // entity that owns locations. It keeps the name `Practice` because it is
  // also the RLS tenant key (app.practice_id) on sixteen tables.
  /**
   * /**
   * /**
   * /**
   * The ABR legal entity name. Often NOT what the practice trades as.
   */
  legalName             String?
  /**
   * Registered business names from the ABR. Practices trade under these.
   */
  tradingNames          String[]  @default([])
  /**
   * Derived from the ABN, never asked for — for a company they cannot differ.
   */
  acn                   String?
  entityType            String? // PTY_LTD | INDIVIDUAL_SOLE_TRADER | TRUST | PARTNERSHIP | ...
  abnStatus             String? // must have been ACTIVE at validation time
  abnVerifiedAt         DateTime?
  /**
   * HOW the ABR details were obtained. `abr_api` means the platform called the
   * ABR and got this back. `manual_attestation` means a named human looked the
   * ABN up on abr.business.gov.au and typed in what they saw.
   * Recorded rather than smoothed over: a manually attested ABN is a person's
   * word, and the reviewer approving the practice is entitled to know that
   * before they approve it.
   */
  abnVerificationSource String? // abr_api | manual_attestation
  /**
   * Who sighted the register, when the source is manual_attestation.
   */
  abnSightedByName      String?
  gstRegistered         Boolean?

  // --- The applicant (ORG-MODEL-PROPOSAL.md §10, step 1) ---
  // Where the passkey invitation goes. Without an email there is nobody to
  // invite and the sequence stalls at step 3.
  /// A SHARED MAILBOX for practice-level notices — recertification reminders,
  /// certification-lapse warnings. Deliberately separate from `adminEmail`.
  ///
  /// `adminEmail` identifies a HUMAN who holds the practice-admin role.
  /// `groupEmail` outlives any individual. Collapsing the two is what creates
  /// a shared account: if the identity address is also the group address, then
  /// everybody with mailbox access can request a credential-enrolment link and
  /// every action becomes attributable to a mailbox rather than a person.
  ///
  /// NOTHING ENROLS AGAINST THIS ADDRESS. It receives notices only. That is
  /// exactly why a change to it is still held and proved, not applied on save
  /// — see PendingEmailChange.field. groupEmail is the WITNESS an adminEmail
  /// handover is told about when the old admin inbox is unreachable, and a
  /// witness changed in the same breath as the thing it watches is a witness
  /// silenced, not merely updated.
  groupEmail String?
  /// Proven by the same hold-and-prove exchange as adminEmail, just without a
  /// handover: nobody's credential moves, only the column.
  groupEmailVerifiedAt DateTime?

  /// PUBLIC, and that is the whole point of them existing separately.
  ///
  /// Every other address here belongs to a person or to us: `adminEmail`
  /// identifies a human and holds their credential, `managerEmail` is the
  /// second named human, `groupEmail` is an internal notices mailbox. None
  /// answers "how do I contact this practice", and showing a practitioner the
  /// administrator's personal address because it was the only one to hand
  /// would publish a person's details to answer a question about a business.
  ///
  /// Optional on purpose: a practice that has not filled these in shows
  /// nothing, rather than falling back to a private address.
  businessPhone String?
  businessEmail String?

  adminName     String?
  adminEmail    String?
  adminPhone    String?
  adminPosition String?

  // How many practitioners the practice says it has, and the cap that follows.
  //
  // Validation is a point-in-time check on the ENTITY; nothing in it limits
  // what that entity does afterwards, and inviting practitioners is how a
  // rogue practice would manufacture identities at scale. The cap is the
  // stated headcount plus room to grow, bounded by a default ceiling — a
  // practice claiming 500 practitioners does not get 600 by saying so.
  //
  // contractedInvitationCap overrides it for hospitals and larger groups, and
  // is set by us, never by them.
  // --- Identity strength, AS AT THE DECISION (IDENTITY-STRENGTH-DESIGN.md §2) ---
  //
  // Stored AND recomputed, deliberately. Stored because this is evidence of
  // what the reviewer was actually shown; recomputed live because that is
  // current risk. Changing a weight next year must never silently rewrite what
  // somebody decided last year.
  //
  // identityWouldPassAtDecision is the whole point of running soft: it records,
  // at every decision, whether HARD enforcement would have admitted this
  // practice. Summed across a year that is the number that says whether the
  // threshold is safe to switch on — and it is unobtainable once you are
  // already enforcing, because you never see what you rejected.
  identityScoreAtDecision       Int?
  identityScoringVersion        String?
  identityWouldPassAtDecision   Boolean?
  identityEnforcementAtDecision String? // soft | hard
  /**
   * Set when a reviewer approved despite hard enforcement saying no.
   */
  identityOverrideReason        String?

  statedPractitionerCount Int?
  contractedInvitationCap Int?
  // A SECOND named person, independently reachable. The reviewer's useful call
  // is to the contact who did NOT apply — a callback whose subject chose the
  // number verifies only that they answer their own phone.
  managerName             String?
  managerEmail            String?
  managerPhone            String?
  managerPosition         String?
  /**
   * Optional. Also a weak entitlement signal when its domain matches adminEmail.
   */
  website                 String?

  // HEAD OFFICE IS NOT A LOCATION, deliberately. A PracticeLocation is a PLACE
  // OF PRACTICE: its address feeds the s 65C(5)(a) particulars and it hosts
  // affiliations. A head office is often a registered or corporate address
  // where nobody practises, and modelling it as a Location would make it
  // selectable as a place of practice — a practitioner's provider number could
  // end up attached to an address they have never attended. When the head
  // office IS also a clinic, the flag creates a Location as well.
  // Structured, because a single line cannot be matched. AHPRA publishes a
  // practitioner's principal place of practice as SUBURB + POSTCODE, G-NAF
  // matches on components, and the ABR reports a locality — none of which can
  // be compared against a sentence.
  headOfficeLine1             String?
  headOfficeLine2             String?
  headOfficeSuburb            String?
  headOfficePostcode          String?
  headOfficeCountry           String? @default("Australia")
  /**
   * What was actually typed. Evidence of the input; never matched on.
   */
  headOfficeAddress           String?
  headOfficeState             String?
  headOfficeIsPlaceOfPractice Boolean @default(false)

  // What the practice offers as proof it is a health practice.
  //
  // There is no general "practice licence" for an Australian GP clinic. AHPRA
  // registers INDIVIDUALS; practices are accredited (RACGP Standards, via
  // AGPAL/QPA/GPA) and identified by HPI-O. So this is a discriminated pair
  // rather than one field pretending to be a licence number.
  //   ahpra         — a responsible practitioner's registration number. The
  //                   only one of the three that is publicly checkable.
  //   hpio          — organisation identifier.
  //   accreditation — verified with the accrediting body, not a public register.
  credentialType  String? // ahpra | hpio | accreditation
  credentialValue String?

  // --- What the approver actually decided (§11) ---
  // The ABN gate proves the ENTITY exists. These record that the APPLICANT was
  // verified to represent it — the real security boundary, which nothing else
  // in this table captures.
  entitlementMethod        String? // phone_call | domain_match | hpio | document | none
  entitlementPhoneNumber   String?
  // WHERE THAT NUMBER CAME FROM. Load-bearing: a number supplied on the
  // application form verifies nothing, because an impersonator supplies their
  // own. AHPRA cannot help — the public register publishes suburb and postcode
  // only, never a phone number or an email.
  entitlementNumberSource  String? // nhsd | practice_website | public_directory | application_form | other
  entitlementSpokeWithName String?
  entitlementCheckedByName String?
  entitlementCheckedAt     DateTime?
  entitlementNote          String?

  // --- The practice admin's account (step 3) ---
  adminKeycloakUserId    String?
  adminInvitedAt         DateTime?

  /// WHEN THE INVITATION DID NOT HAPPEN, and why.
  ///
  /// Validation and invitation are one act. When the second half fails the
  /// first still stands -- correctly, an approval must not be rolled back
  /// because an identity provider was unreachable -- and without this the
  /// failure lived only in a log line. A practice then sits approved with
  /// nobody able to sign in, discoverable only by noticing an absence.
  adminInviteFailedAt DateTime?
  /// Verbatim, in the identity provider's own words. The commonest of these
  /// ("an account already exists with this email") is actionable precisely
  /// because it is specific, and a paraphrase would take that away.
  adminInviteError    String?
  /// A first failure is a bounce. A fourth is a decision about this practice.
  adminInviteAttempts Int       @default(0)
  adminPasskeyEnrolledAt DateTime?
  /**
   * Which registered name the operator's typed name matched, and how closely.
   */
  nameMatchTier          String? // exact | entity_suffix_insensitive
  nameMatchedOn          String?
  hpiO                   String?
  /**
   * BBPIP is all-or-nothing across the practice — one private item forfeits the quarter.
   */
  bbpipParticipant       Boolean?
  /**
   * Gates the enduring MyMedicare pathway entirely.
   */
  myMedicareRegistered   Boolean?

  // --- Human validation queue (ORG-MODEL-PROPOSAL.md §4) ---
  // An ACTIVE ABN with a matching name is necessary, not sufficient. A named
  // human approves before the practice can operate.
  validationState String    @default("pending") // pending | validated | rejected
  validatedByName String?
  validatedAt     DateTime?
  validationNote  String?

  /**
   * Bearer token for the public application-status page.
   * Deliberately NOT the id. A primary key ends up in logs, Referer headers
   * and pasted support tickets, and a primary key that doubles as a credential
   * is a credential that leaks — and one that cannot be rotated without
   * breaking every foreign key pointing at it. This can be reissued on its own.
   * Read only to compose the acknowledgement link. The status lookup itself
   * goes through find_application_by_status_token(), whose narrow projection is
   * the actual security boundary.
   */
  statusToken String @unique @default(dbgenerated("encode(gen_random_bytes(32), 'hex')"))

  /// Email confirmation, two-phase: the token addresses the page, the CODE
  /// confirms. A link alone is consumed by a GET, and mail scanners, link
  /// previews and antivirus gateways all issue GETs — so a link-only scheme
  /// confirms addresses with no human involved. See the migration for why the
  /// attempt cap matters more than the code length.
  adminEmailVerifiedAt            DateTime?
  adminEmailVerificationToken     String?   @unique
  adminEmailVerificationCode      String?
  adminEmailVerificationSentAt    DateTime?
  adminEmailVerificationExpiresAt DateTime?
  adminEmailVerificationAttempts  Int       @default(0)

  /// The practice's backup address — see `Practitioner.backupEmail` for why
  /// this exists. Never equal to `adminEmail`, by CHECK constraint.
  ///
  /// UNPROVED, unlike the practitioner's. Nothing in this codebase writes to a
  /// practice's backup or reads it back, so there is nothing yet for a proof
  /// ceremony to protect — adding the token/code/expiry columns here without a
  /// caller was how core ended up querying a column the database never had.
  /// The practitioner side (practitioner-email.service.ts) is the model to
  /// follow when a practice-level version is actually built.
  backupEmail           String?
  backupEmailVerifiedAt DateTime?

  /// The correction window. Opened by a reviewer rather than at submission, so
  /// the clock does not run down while an application waits in a queue nobody
  /// has reached.
  correctionRequestedAt     DateTime?
  correctionExpiresAt       DateTime?
  correctionRequestedByName String?
  correctionReason          String?

  /// Applicant amendments. The trail itself is in application_amendments; these
  /// are markers so the queue can flag an amended application without a join.
  amendedAt      DateTime?
  amendmentCount Int       @default(0)

  // NOTE: there is deliberately NO banking column here, and there never will
  // be. AoBPlatform holds the consent record, not the money — the payee
  // arrangement is registered directly with Services Australia, with us not
  // in the path. (ORG-MODEL-PROPOSAL.md §8.)

  locations    PracticeLocation[]
  staff        StaffMember[]
  providers    Provider[]
  patients     Patient[]
  assignors    Assignor[]
  agreements   Agreement[]
  departments  Department[]
  affiliations Affiliation[]
  credentials  PracticeCredential[]

  @@map("practices")
}

/**
 * A credential a practice offers as proof it is a health practice. MANY per
 * practice, deliberately — each one is an independent signal, and the more
 * that verify, the harder the whole is to fabricate.
 * THE POINT OF THE VERIFICATION COLUMNS: strength scores attach to VERIFIED
 * credentials, never to entered ones (IDENTITY-STRENGTH-DESIGN.md §1). If
 * typing a number scored, a fraudster would type ten invented ones and clear
 * any threshold — the score would measure effort at the keyboard. So a
 * credential arrives unverified and worth nothing, and only a recorded check
 * by a named human or an API gives it weight.
 */
model PracticeCredential {
  id              String   @id @default(uuid()) @db.Uuid
  practiceId      String   @db.Uuid
  practice        Practice @relation(fields: [practiceId], references: [id])
  /**
   * ahpra | hpio | accreditation | nash | other
   */
  credentialType  String
  credentialValue String
  /**
   * Free text for `other`, and for an accreditation body's name.
   */
  label           String?

  // --- Verification. Absent means worth zero, not "probably fine". ---
  verifiedAt         DateTime?
  verifiedByName     String?
  /**
   * ahpra_register | hi_service | accrediting_body | document_sighted
   */
  verificationMethod String?
  verificationNote   String?

  addedAt     DateTime @default(now())
  addedByName String?

  /// SOFT DELETE. A credential is identity evidence and is never destroyed —
  /// removing one records who and why, exactly as ceasing an agreement does.
  /// The score counts only credentials still offered, so a removal moves it,
  /// and the reason is what explains the movement to somebody reading later.
  removedAt     DateTime?
  removedByName String?
  removedReason String?

  /**
   * The same number twice is a duplicate, not a second signal.
   */
  /// NOT a Prisma @@unique. Uniqueness applies to LIVE rows only, which needs a
  /// PARTIAL index (WHERE "removedAt" IS NULL) that Prisma cannot express — a
  /// removed row would otherwise hold the slot for ever and block re-adding a
  /// credential that was removed by mistake. It is created in the migration
  /// 20260822250000_credentials_soft_delete and enforced by the database.
  @@index([practiceId])
  @@map("practice_credentials")
}

/**
 * Evidence supporting a validation check: screenshots, PDFs, emails.
 * THE BYTES ARE NOT HERE. This row is metadata and a SHA-256; the content
 * lives in the artefact store, and the hash goes into the evidence chain —
 * the same division already used for rendered agreements
 * (`renderedArtefactHash`). immudb holds hashes and events, never blobs.
 * NO CROSS-TENANT DEDUPLICATION, ever, however tempting the storage saving.
 * If identical bytes shared one object, a practice could learn whether another
 * practice had uploaded a given file by observing whether their own upload
 * deduplicated — a side channel that leaks the existence of another customer's
 * evidence. Storage is cheaper than that.
 */
model Artefact {
  id         String @id @default(uuid()) @db.Uuid
  /**
   * Scoping only — there is deliberately NO foreign key.
   * An artefact is append-only evidence: it can be tombstoned, never deleted.
   * A foreign key would therefore make the PRACTICE undeletable forever, since
   * a child row exists that by construction cannot be removed. Evidence
   * outlives its subject on purpose; a foreign key inverts that and makes the
   * subject a hostage to its own evidence. `enrolment_ceremonies` is built the
   * same way, for the same reason.
   */
  practiceId String @db.Uuid

  /**
   * Content address. Also what is published to the vault.
   */
  sha256    String
  sizeBytes Int

  /**
   * What the UPLOADER claimed. Recorded, never acted on.
   */
  declaredContentType  String?
  /**
   * What the bytes actually are. This is what serving uses.
   */
  detectedContentType  String
  /**
   * True when those two disagreed. Innocent usually; a probe sometimes.
   */
  declaredTypeMismatch Boolean @default(false)

  /**
   * Sanitised. Never used to build a storage path — that comes from the hash.
   */
  filename String
  /**
   * entitlement_call | domain_check | website_capture | credential | identity_document | other
   */
  purpose  String

  /**
   * What this is evidence about, once checks exist to attach it to.
   */
  subjectType String?
  subjectId   String? @db.Uuid

  uploadedByName String
  uploadedAt     DateTime @default(now())

  /**
   * Where the store put the bytes. Opaque to everything but the store.
   */
  storageKey String

  // Retention, on the same footing as every other record here.
  retentionExpiryDate DateTime? @db.Date
  legalHold           Boolean   @default(false)
  /**
   * Tombstone: the bytes are gone, the record and its hash remain.
   */
  deletedAt           DateTime?
  deletedReason       String?

  @@index([practiceId])
  @@index([subjectType, subjectId])
  @@map("artefacts")
}

/**
 * ONE ROW PER CHECK PERFORMED. Append-only.
 * A check is never edited — if the facts were wrong, or an unanswered call is
 * tried again, a NEW row is written and both survive. The summary reads the
 * latest per check key; the history stays because "we called twice and nobody
 * answered, then somebody did" is a different story from "we called once".
 * Deliberately NOT foreign-keyed to the practice, for the reason artefacts are
 * not: append-only evidence pinned by referential integrity makes its own
 * parent undeletable forever. `practiceId` is the RLS scoping column.
 */
model PracticeCheck {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid

  /**
   * From the versioned catalogue in packages/domain/src/checks.ts.
   */
  checkKey         String
  /**
   * Which catalogue version defined it. A v1 check must read as v1 forever.
   */
  checklistVersion String
  category         String
  /**
   * The weight AT THE TIME. Re-weighting later must not rewrite history.
   */
  weight           String

  /**
   * passed | failed | not_applicable | could_not_complete
   */
  outcome    String
  /**
   * Required on failed and could_not_complete, from that outcome's own list.
   */
  reasonCode String?
  /**
   * Required on failed and not_applicable. Always allowed.
   */
  note       String?

  /**
   * Structured detail the check requires — a phone number and its source.
   */
  fields Json?

  performedByName String
  performedAt     DateTime @default(now())

  @@index([practiceId])
  @@index([practiceId, checkKey])
  @@map("practice_checks")
}

model PracticeLocation {
  id           String   @id @default(uuid()) @db.Uuid
  practiceId   String   @db.Uuid
  practice     Practice @relation(fields: [practiceId], references: [id])
  /**
   * What was typed. RETAINED as evidence of the input; the structured fields
   * below are what anything matches on, and s 65C(5)(a) renders from those
   * (FR-1.1).
   */
  address      String
  addressLine1 String?
  addressLine2 String?
  suburb       String?
  postcode     String?
  country      String?  @default("Australia")
  /**
   * The practice's own label for the site ("Main St", "After Hours").
   */
  code         String?
  /**
   * Per-LOCATION, because a multi-state practice needs per-site holidays (REQ-OFF-03).
   */
  state        String?

  // --- Address validation (ORG-MODEL-PROPOSAL.md §9) ---
  // Validated against a locally-held G-NAF extract: no runtime network
  // dependency, and no address ever leaves our infrastructure — which matters
  // because address is one of the six approved patient identifiers.
  addressValidated Boolean @default(false)

  // --- HOW it was confirmed, and by whom (packages/domain/src/address-check.ts) ---
  // "Confirmed" on its own cannot be weighed by anybody later. A confirmation
  // that does not say what was checked is an assertion wearing a check's name,
  // and it reads identically to one that was done properly.
  /// From ADDRESS_CHECK_METHODS. Never free text.
  addressCheckMethod     String?
  /// Which catalogue version defined it. A v1 confirmation must read as v1 for ever.
  addressCheckVersion    String?
  addressCheckNote       String?
  /// The evidence itself. NO foreign key, for the reason given on Artefact:
  /// evidence outlives its subject, and a key would invert that.
  addressCheckArtefactId String?   @db.Uuid
  addressCheckedAt       DateTime?
  /// The Keycloak subject. Stable, and the thing to join on.
  addressCheckedBySub    String?
  /// Display name at the time. Denormalised on purpose — an audit line must
  /// still read correctly after somebody is renamed or leaves.
  addressCheckedByName   String?

  // --- Sent back to the practice, with a reason they can act on ---
  // A reviewer who should NOT confirm previously had nothing to do but walk
  // away, which left the practice locked out with no way to learn why.
  addressRejectedAt      DateTime?
  /// From ADDRESS_REJECTION_REASONS.
  addressRejectedReason  String?
  addressRejectedDetail  String?
  addressRejectedByName  String?
  /**
   * The canonical G-NAF form. What renders on the agreement, not what was typed.
   */
  addressCanonical String?
  gnafPid          String?
  gnafVersion      String?

  /**
   * A location cannot host affiliations until its address validates. Defaults
   * FALSE: a site nobody has confirmed exists must not appear on a s 65C(5)(a)
   * particulars block.
   */
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  departments  Department[]
  affiliations Affiliation[]

  @@index([practiceId])
  @@map("practice_locations")
}

/**
 * An optional subdivision of a location — "Emergency", "Oncology", "Allied
 * Health". Purely organisational: nothing in s 65C turns on it, and an
 * affiliation may name one or not.
 */
model Department {
  id         String           @id @default(uuid()) @db.Uuid
  practiceId String           @db.Uuid
  practice   Practice         @relation(fields: [practiceId], references: [id])
  locationId String           @db.Uuid
  location   PracticeLocation @relation(fields: [locationId], references: [id])
  name       String
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())

  affiliations Affiliation[]

  @@unique([locationId, name])
  @@index([practiceId])
  @@map("departments")
}

/**
 * A human practitioner — ONE ROW PER PERSON, ACROSS THE WHOLE PLATFORM.
 * DELIBERATELY NOT PRACTICE-SCOPED, and therefore deliberately not covered by
 * an RLS practice_isolation policy. That is the entire point: a doctor working
 * at three practices is ONE person, and modelling them as three unrelated rows
 * (which is what `providers` does today) makes it impossible to enforce a
 * deregistration hard-stop across all three, to detect anomalous affiliation
 * velocity, or to show the practitioner what has been signed in their name.
 * Because RLS cannot scope this table, the boundary is enforced in code: a
 * practitioner crosses a practice boundary ONLY through
 * `toDirectoryEntry()` (packages/domain/src/directory.ts), which is built
 * field-by-field and carries the AHPRA number, never the provider number.
 */
model Practitioner {
  id           String  @id @default(uuid()) @db.Uuid
  /**
   * National, public, and unique — the one identifier safe to key on.
   */
  ahpraNumber  String  @unique
  familyName   String
  givenNames   String
  providerType String // general_practitioner | specialist | allied_health | nurse_practitioner | optometrist | other
  /**
   * PRACTITIONER-owned, not practice-owned. Invitations go here so a practice
   * cannot accept an affiliation on the practitioner's behalf.
   */
  email        String?

  /**
   * A SECOND CHANNEL, and the piece that makes holding an address change
   * workable rather than merely strict.
   *
   * Requiring the OLD address to authorise a change defeats takeover
   * completely and breaks the commonest legitimate case — the old mailbox is
   * gone, which is WHY they are changing it. A backup is an address that is
   * not the one being changed, so the warning still reaches somebody.
   *
   * Never equal to `email`: one inbox covering both is one compromise
   * covering both. Enforced by a CHECK constraint, because the form is not
   * the only caller.
   */
  backupEmail           String?
  backupEmailVerifiedAt DateTime?

  /**
   * PROVING the backup, rather than merely announcing it.
   *
   * `backupEmailVerifiedAt` existed from the start and nothing ever set it —
   * the address was stored, a notice was sent, and that was the whole of it.
   * A backup nobody has ever had an answer from is not a second channel; it
   * is a guess, discovered to be one at exactly the moment somebody needs it,
   * during a takeover when the primary is already gone. A typo is the common
   * case, not an attack.
   *
   * Same shape as every other proof here: a token in the link, a code for the
   * human, an expiry, and a count of attempts.
   */
  backupEmailToken     String?   @unique
  backupEmailCode      String?
  backupEmailExpiresAt DateTime?
  backupEmailAttempts  Int       @default(0)

  /**
   * Which validated practice created this identity (CONVENTIONS.md §8b).
   * There is no self-registration path, so this always has an answer: "who
   * vouched for this practitioner existing at all" is never unanswerable. No
   * foreign key — the identity outlives the practice that introduced it, and
   * being between jobs is not a reason to cease existing.
   */
  invitedByPracticeId String? @db.Uuid

  /**
   * FR-1.9 — passkey identity. Practitioner-level: you verify a person once.
   */
  keycloakUserId    String?
  invitedAt         DateTime?

  passkeyEnrolledAt DateTime?
  /**
   * Set when a sufficient REQ-PKI-01 ceremony has been performed.
   */
  verifiedAt        DateTime?

  // --- What the AHPRA public register said, and who looked ---
  //
  // Captured rather than inferred. The register is the authority on whether a
  // practitioner may practise; nothing else here is.
  registrationStatus        String? // Registered | Suspended | Cancelled | ...
  profession                String?
  division                  String?
  /**
   * Practitioner-level restrictions, distinct from per-registration-type ones.
   */
  conditions                String?
  undertakings              String?
  reprimands                String?
  dateOfFirstRegistration   DateTime? @db.Date
  // The register publishes the principal place of practice as SUBURB and
  // POSTCODE only — never a street address, never an email, never a phone.
  principalSuburb           String?
  principalState            String?
  principalPostcode         String?
  principalCountry          String?
  /**
   * ahpra_manual (a named human read the register) | pie_api (paid service).
   */
  registrationSource        String?
  registrationSightedByName String?
  registrationSightedAt     DateTime?

  /**
   * REQ-XFER-08 — an immediate hard stop across EVERY affiliation. No notice
   * period, no waiting for a practice to tell us.
   */
  deregisteredAt     DateTime?
  deregisteredReason String?

  createdAt DateTime @default(now())

  affiliations  Affiliation[]
  registrations PractitionerRegistration[]
  /// Every register check, newest last. See PractitionerRegisterCheck.
  registerChecks PractitionerRegisterCheck[]

  @@map("practitioners")
}

/**
 * ONE ROW PER REGISTRATION TYPE HELD.
 * A practitioner commonly holds several at once — the record we checked held
 * General AND Specialist (General practice), each with its own expiry date,
 * conditions, endorsements and notations. Modelling expiry as a single column
 * on the practitioner would silently pick one of them and call it the answer.
 */
/**
 * EVERY REGISTER CHECK, not just the most recent.
 *
 * The three `registrationSighted*` columns on `Practitioner` were overwritten
 * by each new check, so "who checked this and what did it say" had one answer
 * at a time and asking again destroyed the previous one. A check is somebody's
 * statement that on a given day the public register said a particular thing —
 * it does not stop being true because a later check was made, and the earlier
 * reading is exactly what somebody needs when asked why a capture in April was
 * allowed.
 *
 * The columns on `Practitioner` stay as the CURRENT value. They are now a cache
 * of the newest row here rather than the only record.
 */
model PractitionerRegisterCheck {
  id             String       @id @default(uuid()) @db.Uuid
  practitionerId String       @db.Uuid
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  /// What the register said, as read on the day.
  registrationStatus String
  profession         String?
  division           String?
  conditions         String?
  undertakings       String?
  reprimands         String?

  /// WHO said so, and how. `source` keeps a human reading the register apart
  /// from an API answering: different kinds of evidence, and flattening them
  /// would make the weaker look like the stronger.
  source        String
  sightedByName String?
  sightedAt     DateTime

  createdAt DateTime @default(now())

  @@index([practitionerId, sightedAt])
  @@map("practitioner_register_checks")
}

model PractitionerRegistration {
  id               String       @id @default(uuid()) @db.Uuid
  practitionerId   String       @db.Uuid
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id])
  registrationType String // General | Specialist | Limited | Provisional | Non-practising
  specialty        String?
  /**
   * MAY BE IN THE PAST WITHOUT MEANING ANYTHING IS WRONG. AHPRA: a past expiry
   * may mean a renewal is still being finalised, or the one-month late period
   * — "they are still able to practise". Warn, never block.
   */
  expiryDate       DateTime?    @db.Date
  conditions       String?
  endorsements     String?
  notations        String?
  createdAt        DateTime     @default(now())

  @@index([practitionerId])
  @@map("practitioner_registrations")
}

/**
 * The practitioner-to-location edge, and the thing that carries the provider
 * number.
 * FR-1.8: "provider number PER LOCATION (a practitioner has one per place of
 * practice)". REQ-REG-02 identifies a provider by name + the address of the
 * place of practice, OR by the provider number FOR THAT PLACE OF PRACTICE. So
 * the number is a property of a doctor AT A PLACE, and this is that place.
 * Agreements anchor here, which makes REQ-XFER-01 fall out for free: a
 * practitioner who moves gets a NEW affiliation and therefore a NEW agreement.
 * There is no transfer path because there is nothing to transfer.
 */
model Affiliation {
  id             String           @id @default(uuid()) @db.Uuid
  practiceId     String           @db.Uuid
  practice       Practice         @relation(fields: [practiceId], references: [id])
  practitionerId String           @db.Uuid
  practitioner   Practitioner     @relation(fields: [practitionerId], references: [id])
  locationId     String           @db.Uuid
  location       PracticeLocation @relation(fields: [locationId], references: [id])
  departmentId   String?          @db.Uuid
  department     Department?      @relation(fields: [departmentId], references: [id])

  /**
   * Optional by design — s 65C(5)(a) name+address OR (b) provider number.
   */
  providerNumber String?
  /**
   * PMS linkage for this practitioner at this site.
   */
  pmsLinkageKey  String?

  status    String   @default("invited") // invited | active | ending | ended | rejected
  invitedAt DateTime @default(now())

  /// The invitation itself: a link to a page, and a CODE to type into it.
  ///
  /// Two-phase for the same reason email verification is (see that migration):
  /// a bare link is consumed by a GET, and scanners, preview bots and "safe
  /// links" rewriting all issue GETs.
  ///
  /// Cleared on ANY answer, accept or decline, so neither a forwarded link nor
  /// a screenshot of the email can be replayed.
  inviteToken     String?   @unique
  inviteCode      String?
  inviteSentAt    DateTime?
  inviteExpiresAt DateTime?
  inviteAttempts  Int       @default(0)

  /// HOW they answered: email_link_and_code | passkey | console.
  ///
  /// A token and a code in the SAME email prove somebody read that email. They
  /// do not prove WHO — that is proof of access to an inbox, and it is recorded
  /// as exactly that rather than as "the practitioner signed". This column
  /// exists so that when passkey acceptance lands (FR-1.9) the two remain
  /// distinguishable in evidence, instead of blurring into one
  /// undifferentiated "accepted".
  acceptanceMethod String?
  invitedByName    String?
  /**
   * Set on acceptance BY THE PRACTITIONER — a practice cannot self-accept.
   */
  startedAt        DateTime?
  rejectedAt       DateTime?

  // --- Offboarding: notice runs BEFORE the end date (§6) ---
  /**
   * /**
   * /**
   * /**
   * Must be <= endsAt. Enforced by a CHECK constraint, not just in code.
   */
  noticeGivenAt DateTime?
  noticeGivenBy String?

  // --- Notice given OUTSIDE AoBPlatform (packages/domain/src/departure-notice.ts) ---
  //
  // A departure that already happened cannot have been noticed through us.
  // Refusing to record it did not prevent the departure — it only left the
  // platform showing a practitioner as active at a location they had left,
  // which is the worse falsehood.
  //
  // So the practice may attest that notice was given elsewhere, and that
  // attestation is stored AS an attestation. It is never relabelled as our
  // own notice: the whole value of the record is that a reader can tell the
  // two apart.
  /// From EXTERNAL_NOTICE_MEANS. Null means notice came through the platform.
  externalNoticeMeans   String?
  /// When notice was ACTUALLY given, outside.
  externalNoticeGivenAt DateTime?
  externalNoticeNote    String?
  /// Who attested it, from the verified token.
  externalNoticeAttestedBy String?
  /// Business days between notice and departure. Negative if notice came after.
  noticeLeadBusinessDays Int?
  /// Set when the record itself shows a problem, so it is visible without
  /// recomputing: short notice, or notice dated after the departure.
  noticeAnomaly         String?
  endsAt        DateTime?
  endedAt       DateTime?
  endReason     String? // practitioner_left_location | deregistered | rejected

  createdAt DateTime @default(now())

  agreements Agreement[]

  /**
   * One provider number per practitioner per location — the FR-1.8 shape.
   */
  @@unique([practitionerId, locationId])
  @@index([practiceId])
  @@index([practitionerId])
  @@index([status])
  @@map("affiliations")
}

/**
 * FR-1.5 — the staff list. Feeds the practitioner-employee assignor hard
 * block (REQ-VUL-04): practice staff cannot be assignors. Identity/passkey
 * enrolment attaches when Keycloak lands.
 */
model StaffMember {
  id                String    @id @default(uuid()) @db.Uuid
  practiceId        String    @db.Uuid
  practice          Practice  @relation(fields: [practiceId], references: [id])
  name              String
  dateOfBirth       DateTime? @db.Date
  role              String // front_desk | practice_manager | principal
  active            Boolean   @default(true)
  email             String?
  /**
   * FR-1.5 — passkey enrolment is mandatory for admin roles at first login.
   */
  keycloakUserId    String?
  invitedAt         DateTime?
  /// How many enrolment links we have sent. Counted rather than replaced:
  /// "written to four times, never signed in" is the situation worth acting
  /// on, and a single timestamp hides it.
  invitationsSent   Int       @default(0)
  passkeyEnrolledAt DateTime?

  // --- Console access (packages/domain/src/practice-users.ts) ---
  //
  // SEPARATE FROM `role` ON PURPOSE. `role` says what somebody does at the
  // practice and feeds the assignor block (REQ-VUL-04). This says what they
  // may do in AoBPlatform. A principal may have no console access at all and
  // a receptionist may run every report — collapsing the two would grant
  // access as a side effect of describing a job.
  //
  // NULL means no sign-in access. A staff record is not an account until
  // somebody deliberately makes it one.
  /// admin | other
  consoleRole       String?

  // WHERE their access reaches. Both null = the whole practice. No foreign
  // keys: a location can be closed while the person who worked there must
  // stay identifiable on records they touched.
  locationId        String?   @db.Uuid
  departmentId      String?   @db.Uuid

  // --- Inactivity lifecycle ---
  //
  // 6 months quiet -> warn. 3 more -> deactivate. NEVER DELETE: somebody who
  // approved or confirmed something must stay identifiable for as long as
  // that record matters, which outlasts their employment.
  lastSignInAt      DateTime?
  inactivityWarnedAt DateTime?
  deactivatedAt     DateTime?
  deactivatedReason String?
  /// Who withdrew it. From the verified token, never a typed name.
  deactivatedByName String?

  @@index([practiceId])
  /// The console-user list, and the cap count.
  @@index([practiceId, consoleRole])
  @@map("staff_members")
}

model Provider {
  id                     String    @id @default(uuid()) @db.Uuid
  practiceId             String    @db.Uuid
  practice               Practice  @relation(fields: [practiceId], references: [id])
  name                   String
  providerType           String // general_practitioner | specialist | allied_health | nurse_practitioner | optometrist | other
  placeOfPracticeAddress String?
  providerNumber         String? // optional by design — s 65C(5)(a) OR (b), REQ-REG-02
  ahpraNumber            String?
  pmsLinkageKey          String?
  active                 Boolean   @default(true)
  /**
   * FR-1.9 — link to the Keycloak account. Null until invited.
   */
  keycloakUserId         String?
  invitedAt              DateTime?
  passkeyEnrolledAt      DateTime?

  agreements Agreement[]

  @@index([practiceId])
  @@map("providers")
}

model Patient {
  id                   String   @id @default(uuid()) @db.Uuid
  practiceId           String   @db.Uuid
  practice             Practice @relation(fields: [practiceId], references: [id])
  familyName           String
  givenNames           String
  dateOfBirth          DateTime @db.Date
  genderAsIdentified   String?
  address              String?
  patientRecordNumber  String?
  ihi                  String?
  preferredLanguage    String?
  mobile               String?
  email                String?
  confidentialityFlag  Boolean  @default(false) // REQ-CHILD-01; fail closed (REQ-CHILD-07)
  myMedicareRegistered Boolean?
  pmsLinkageKey        String?

  agreements Agreement[]

  @@index([practiceId])
  @@map("patients")
}

/**
 * An appointment as the PMS reported it — the PRE-consultation trigger.
 *
 * Mirrored for one reason: idempotency. The appointment feed is read again
 * and again (a morning list, then an arrival slip for the same patient, then
 * tomorrow's list) and one appointment must never open two capture requests.
 * `pmsAppointmentKey` is the handle the PMS gave it; everything about the
 * person stays on `Patient`, mirrored by linkage key as the invoice sync does
 * (REQ-DATA-10 — the PMS is the source of truth for who they are).
 *
 * `agreementId` is the pre-agreement drafted for it, or NULL where the
 * cascade decided not to ask (recorded on a `capture.suppressed` event).
 */
model Appointment {
  id                String    @id @default(uuid()) @db.Uuid
  practiceId        String    @db.Uuid
  pmsAppointmentKey String
  patientId         String?   @db.Uuid
  providerId        String?   @db.Uuid
  date              DateTime  @db.Date
  time              String?
  agreementId       String?   @db.Uuid
  createdAt         DateTime  @default(now())

  @@unique([practiceId, pmsAppointmentKey])
  @@index([practiceId, date])
  @@map("appointments")
}

model Assignor {
  id                    String    @id @default(uuid()) @db.Uuid
  practiceId            String    @db.Uuid
  practice              Practice  @relation(fields: [practiceId], references: [id])
  name                  String
  dateOfBirth           DateTime? @db.Date // needed for the 18+ rule (REQ-AGE-01/-04)
  relationshipToPatient String?
  authorityBasis        String // self | parent | spouse | co_resident_relative_18_plus | guardian | health_epoa | other_with_note
  authorityNote         String?
  contactMobile         String?
  contactEmail          String?
  preferredLanguage     String?
  /**
   * WHEN THE SELF-DECLARATION WAS MADE, not whether it was checked. Reg
   * 65CB(5) makes authority self-declared (REQ-VUL-02); the platform records
   * the declaration and never verifies it, and never asks about capacity
   * (REQ-VUL-05).
   */
  authorityDeclaredAt   DateTime?
  /**
   * REQ-AGE-01 — the on-screen declaration that the person acting for another
   * is of full age. A TIMESTAMP OF A DECLARATION, never a date of birth: we
   * hold no DOB for a third-party assignor, and REQ-AGE-04 forbids trusting
   * an attestation where one IS held.
   */
  declaredOfFullAgeAt   DateTime?
  /** C7.2 — channel preference is per ASSIGNOR, because the signer is not always the patient. */
  preferredChannel      String? // mobile | email

  agreements Agreement[]

  @@index([practiceId])
  @@map("assignors")
}

model Agreement {
  id                    String       @id @default(uuid()) @db.Uuid
  practiceId            String       @db.Uuid
  practice              Practice     @relation(fields: [practiceId], references: [id])
  type                  String // episodic_pre | episodic_post | treatment_plan | enduring
  // Polymorphic immutable anchor (HARD-01): provider for everything except
  // the ACCHO/AMS enduring pathway, which anchors to an organisation.
  anchorKind            String // provider | organisation
  providerId            String?      @db.Uuid
  provider              Provider?    @relation(fields: [providerId], references: [id])
  /**
   * The new anchor. `providerId` above is the legacy one and is being retired:
   * both are covered by the HARD-01 immutability trigger meanwhile, so neither
   * can be edited on a live agreement.
   */
  affiliationId         String?      @db.Uuid
  affiliation           Affiliation? @relation(fields: [affiliationId], references: [id])
  organisationId        String?      @db.Uuid
  patientId             String       @db.Uuid
  patient               Patient      @relation(fields: [patientId], references: [id])
  assignorId            String       @db.Uuid
  assignor              Assignor     @relation(fields: [assignorId], references: [id])
  assignorIsPatient     Boolean // D7 — explicit, never inferred
  /**
   * The assignor this agreement pointed at while the patient was signing for
   * themselves, remembered when it is re-pointed at somebody else so that
   * reverting is exact rather than a guess. Without it "the patient is signing
   * after all" would have to find a self-assignor by name, which is how one
   * person ends up with three rows and the wrong one gets the copy.
   */
  patientAssignorId     String?      @db.Uuid
  enduringPathway       String? // mymedicare | residential_aged_care | accho_ams
  status                String       @default("draft")
  /**
   * D6a BEFORE THE LOCK — the Basic Service Description a staff member chose
   * for a draft pre-agreement the PMS gave no appointment type for.
   *
   * IT IS NOT THE SNAPSHOT AND MUST NOT BE READ AS ONE. `particulars` below is
   * the frozen, hashed, rendered contract; this is the one particular the
   * server could not know, parked on the draft so that `lockParticulars`
   * assembles it from the platform's OWN records like every other field
   * (REQ-DATA-11) rather than taking it from whichever client happens to be
   * locking. It is exactly why the kiosk sends no description: the tablet must
   * never present a field a patient could fill on the practice's behalf
   * (Carl, 3 Sep 2026).
   *
   * WHICH LIST IT CAME FROM IS ON THE VAULT EVENT, not here — the same
   * reasoning as `relationshipsVersion`. What the practice was OFFERED at the
   * time is evidence; what the agreement holds now is current state, and the
   * lock records the rules engine's own `mappingVersion` beside it.
   *
   * Only ever set while the draft is unlocked; a database trigger refuses a
   * change after `particularsLockedAt`, because after that the artefact has
   * been rendered and hashed against these words (HARD-02: corrections
   * supersede, they do not edit).
   */
  serviceDescription    String?
  /** The staff member who chose it, by display name. The vault event holds their subject id. */
  serviceDescriptionSetBy String?
  serviceDescriptionSetAt DateTime?
  // Snapshot of the s 65C particulars as rendered and locked (REQ-DATA-11).
  particulars           Json?
  particularsLockedAt   DateTime?
  ruleSetVersion        String? // rule 14 / REQ-65C-02
  mappingVersion        String?
  renderedLanguages     String[]     @default([])
  renderedArtefactHash  String? // SHA-256 at render (REQ-VAULT-02)
  rendererVersion       String? // renderers are versioned content — re-verify with THIS version (rule 13/14)
  verificationEventId   String?      @db.Uuid
  signatureEventId      String?      @db.Uuid
  supersedesAgreementId String?      @db.Uuid // HARD-02: corrections supersede
  retentionExpiryDate   DateTime?    @db.Date
  legalHold             Boolean      @default(false)
  // FR-9.3 write-back tracking: the artefact lands in the PMS patient record
  // (REQ-INT-02); unwritten stored agreements are retried by the sweep and
  // alerted when stale.
  pmsDocumentKey        String?
  writtenBackAt         DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([practiceId])
  @@index([patientId])
  @@index([status])
  @@index([affiliationId])
  @@map("agreements")
}

/**
 * REQ-PKI-01 — the practitioner enrolment ceremony that must precede binding a
 * passkey. "The key is only as good as the ceremony that bound it."
 * APPEND-ONLY EVIDENCE. Nothing edits a ceremony: if the facts were wrong, a
 * fresh ceremony is performed. The record answers, permanently, WHO attested
 * that these three checks were done and HOW.
 */
model EnrolmentCeremony {
  id                       String    @id @default(uuid()) @db.Uuid
  practiceId               String    @db.Uuid
  /**
   * Exactly one of these. Staff with admin roles need passkeys too (rule 15).
   */
  providerId               String?   @db.Uuid
  staffId                  String?   @db.Uuid
  /**
   * The ceremony verifies a HUMAN, so it belongs on the practitioner, not on
   * an affiliation: a doctor verified by video for practice A does not need
   * re-verifying for practice B. The provider-number check is the part that is
   * location-specific, and that lives on the affiliation.
   */
  practitionerId           String?   @db.Uuid
  // WHAT KIND OF PERSON this ceremony verified.
  //
  // `practitioner`   — the REQ-PKI-01 three checks: AHPRA registration, the
  //   provider number at its location, and the person by video or in person.
  //
  // `practice_admin` — an administrator has no AHPRA number and no provider
  //   number. Demanding those fields would force someone to invent one,
  //   putting a fabricated registration number into permanent evidence. What
  //   verifies an admin is the ORGANISATION APPROVAL: a named human checked
  //   the ABN, the name, the address, and the applicant's entitlement to act
  //   for the entity. A stronger attestation, of different facts — referenced
  //   here rather than restated.
  subjectKind              String    @default("practitioner")
  // Check 1 — current AHPRA registration. Practitioner ceremonies only.
  ahpraNumber              String?
  ahpraRegistrationCurrent Boolean   @default(false)
  // Check 2 — the provider number AND the place of practice it is valid for.
  providerNumber           String?
  providerNumberLocation   String?
  providerNumberVerified   Boolean   @default(false)
  /**
   * For a practice_admin ceremony: the organisation whose approval stands in.
   */
  approvedOrganisationId   String?   @db.Uuid
  // Check 3 — the person.
  personVerificationMethod String // video | in_person
  /**
   * The named human who performed the checks. Never "system".
   */
  verifiedByName           String
  verifiedByStaffId        String?   @db.Uuid
  evidenceNote             String?
  /**
   * REQ-PKI-05 — re-enrolment (recovery) must be explicitly stepped up.
   */
  steppedUp                Boolean   @default(false)
  performedAt              DateTime
  /**
   * Set when this ceremony was actually used to authorise a key binding.
   */
  consumedAt               DateTime?
  createdAt                DateTime  @default(now())

  @@index([practiceId])
  @@index([providerId])
  @@index([staffId])
  @@index([practitionerId])
  @@map("enrolment_ceremonies")
}

// M3 — verification (REQ-VER-01..04, FR-3.1..3.4).
// THE STRUCTURAL RULE OF THESE TWO TABLES: identifier VALUES never land in
// them. Types and outcomes only (REQ-VER-04, HARD-04). There is no column
// capable of carrying a stated value, and the service discards values after
// the constant-time comparison.

model VerificationChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  practiceId      String    @db.Uuid
  patientId       String    @db.Uuid
  channel         String // in_practice | sms_link | email_link | portal | paper
  identifierTypes String[] // the types challenged — from the approved six only
  attempts        Int       @default(0)
  lockedAt        DateTime?
  passedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([practiceId])
  @@index([patientId])
  @@map("verification_challenges")
}

model VerificationEvent {
  id                String   @id @default(uuid()) @db.Uuid
  practiceId        String   @db.Uuid
  patientId         String   @db.Uuid
  challengeId       String   @db.Uuid
  identifierTypes   String[]
  outcome           String // passed | failed | locked_out
  channel           String
  /**
   * Staff member identity for staff-verified in-practice capture.
   */
  verifiedByStaffId String?
  createdAt         DateTime @default(now())

  @@index([practiceId])
  @@map("verification_events")
}

// M2 — capture cascade (FR-2.1, FR-2.3, FR-2.7).
// The remote-link token is NEVER stored: the row holds sha256(secret) only,
// so a database read cannot mint working links. Tokens are single-use and
// expire per practice config (default below until D-05 closes).

model CaptureRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  practiceId              String    @db.Uuid
  agreementId             String    @db.Uuid
  channel                 String // in_practice | sms_link | email_link | paper
  tokenHash               String?   @unique // remote channels only
  expiresAt               DateTime?
  status                  String    @default("open") // open | completed | cancelled | expired
  verificationChallengeId String?   @db.Uuid
  completedAt             DateTime?
  createdAt               DateTime  @default(now())

  @@index([practiceId])
  @@index([agreementId])
  @@map("capture_requests")
}

// REQ-SIG-02 — the signature event binds the hash of the exact rendered
// agreement, the rule-set + mapping versions, the preceding verification
// event, timestamp, channel, device and IP, and the assignor's authority
// basis. Append-only evidence, like verification events.

model SignatureEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  practiceId          String   @db.Uuid
  agreementId         String   @db.Uuid
  captureRequestId    String?  @db.Uuid
  method              String // drawn | tap_to_approve | typed_name | wet_ink_scan | verbal_recorded
  channel             String
  artefactHash        String // SHA-256 of the exact rendered artefact
  rendererVersion     String
  ruleSetVersion      String?
  mappingVersion      String?
  verificationEventId String?  @db.Uuid
  deviceFingerprint   String?
  ipAddress           String?
  createdAt           DateTime @default(now())

  /**
   * THE MARK ITSELF (REQ-SIG-01/-02). A `drawn` signature stores two
   * artefacts — the PNG the pad produced and the strokes with their timing,
   * exactly as captured — and the event binds BOTH hashes alongside
   * `artefactHash`, which is the rendered agreement's. Null for every method
   * that has no mark to store: tap-to-approve is a real signature and draws
   * nothing.
   *
   * THE HASHES ARE HERE, THE BYTES ARE NOT. Same division as
   * `renderedArtefactHash` on an agreement: the encrypted artefact store holds
   * the content, this row and the vault event hold its identity. The strokes
   * are the assignor's own hand and never appear in a log or an error.
   */
  signatureRasterArtefactId String? @db.Uuid
  signatureRasterSha256     String?
  signatureVectorArtefactId String? @db.Uuid
  signatureVectorSha256     String?
  /**
   * The pad's logical size the coordinates were captured against, without
   * which the vector cannot be redrawn at any other size.
   */
  padWidth                  Float?
  padHeight                 Float?
  /** Shape only — how many strokes and points. Never a score, never a judgement. */
  strokeCount               Int?
  pointCount                Int?

  @@index([practiceId])
  @@index([agreementId])
  @@map("signature_events")
}

// M5 — enduring agreement detail (reg 65CB content set, REQ-END-02). One row
// per Agreement where type = 'enduring'. Kept separate from Agreement so the
// episodic path carries none of it.
//
// notificationMethod is REQUIRED: reg 89AA obliges notice by the method named
// IN THE AGREEMENT, so a notice cannot be composed without it (REQ-DEL-02).

model EnduringDetail {
  id                       String    @id @default(uuid()) @db.Uuid
  practiceId               String    @db.Uuid
  agreementId              String    @unique @db.Uuid
  /**
   * How reg 89AA notices must be delivered. Method fidelity is checked against this.
   */
  notificationMethod       String // sms | email | post | portal
  notificationAlternate    String? // REQ-DEL-04 fallback within the window
  terminationMethod        String
  responsiblePersonBasis   String?
  /**
   * Patient (14+) written declaration where the patient is not the assignor (REQ-END-02).
   */
  patientDeclarationAt     DateTime?
  /**
   * MBS Category | Group | Subgroup | Item, or a combination (REQ-END-06a).
   */
  scopeType                String
  scopeValues              String[]
  /**
   * The date the agreement was entered into — the anniversary fuse anchor (65CA(8)(e)).
   */
  enteredIntoAt            DateTime
  /**
   * D-11: no registration mechanism is published. Tracked, never speculated on.
   */
  registeredAt             DateTime?
  registrationReference    String?
  /**
   * Termination (REQ-END-06): notice, then 2 BUSINESS days.
   */
  terminationNoticeAt      DateTime?
  terminationEffectiveAt   DateTime?
  /**
   * Which state's public-holiday calendar produced terminationEffectiveAt (REQ-OFF-03).
   */
  terminationCalendarState String?
  ceasedAt                 DateTime?
  cessationReason          String?
  createdAt                DateTime  @default(now())

  @@index([practiceId])
  @@index([ceasedAt])
  @@map("enduring_details")
}

// M6 — reg 89AA post-claim notices. MyMedicare pathway ONLY (REQ-END-05).
//
// THE ONE PLACE A BENEFIT AMOUNT LIVES (CLAUDE.md rule 4): agreements never
// carry one; this notice must, by regulation. Corrections SUPERSEDE via
// supersedesNoticeId — nothing edits a dispatched notice (REQ-DEL-06).

model Notice {
  id                 String    @id @default(uuid()) @db.Uuid
  practiceId         String    @db.Uuid
  agreementId        String    @db.Uuid
  serviceRecordId    String?   @db.Uuid
  claimReference     String
  /**
   * The 24-hour clock starts here — at claim lodgement, not the service.
   */
  claimLodgedAt      DateTime
  // The four mandatory elements, snapshotted at compose time.
  practitionerName   String
  patientName        String
  serviceDate        DateTime  @db.Date
  benefitAmountCents Int
  /**
   * Method named in the agreement; dispatch channel must equal it (REQ-DEL-02).
   */
  agreementMethod    String
  dispatchChannel    String?
  payloadHash        String
  // The five states, each independently timestamped (REQ-DEL-01). Never
  // collapsed to a boolean; `readAt` is evidential colour only (REQ-DEL-07).
  composedAt         DateTime  @default(now())
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  failureCode        String?
  failureReason      String?
  attempts           Int       @default(0)
  gatewayMessageId   String?
  supersedesNoticeId String?   @db.Uuid
  correctionReason   String?

  @@index([practiceId])
  @@index([agreementId])
  @@index([claimLodgedAt])
  @@map("notices")
}

/**
 * Append-only delivery evidence — one row per state transition (REQ-DEL-01).
 */
model NoticeDeliveryEvent {
  id         String   @id @default(uuid()) @db.Uuid
  practiceId String   @db.Uuid
  noticeId   String   @db.Uuid
  state      String // composed | dispatched | delivered | read | failed
  channel    String?
  detail     Json?
  occurredAt DateTime @default(now())

  @@index([practiceId])
  @@index([noticeId])
  @@map("notice_delivery_events")
}

// M7/M9 — a service (rendered item) observed from the PMS. The reconciliation
// queue (REQ-REC-01) is "service records without a stored agreement, ranked by
// days remaining on the 12-month lodgement window". The retention/lodgement
// clock defaults conservatively to the service date where claim events are
// unobservable (REQ-INT-04) — recorded explicitly, never inferred.

model ServiceRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  practiceId           String   @db.Uuid
  pmsInvoiceKey        String
  patientId            String?  @db.Uuid
  providerId           String?  @db.Uuid
  serviceDate          DateTime @db.Date
  mbsItemNumbers       String[]
  agreementId          String?  @db.Uuid
  retentionClockSource String   @default("conservative_default") // observed_claim | practice_asserted | conservative_default
  /**
   * WHY THE CASCADE DID NOT ASK, the last time it looked (AutoCaptureSuppressionReason).
   * The vault event is the record; this is the word the queue screen shows
   * beside the item so a person can see at a glance what is left to them —
   * "under 14", "no way to reach", "window closed" — rather than a bare
   * "needs agreement". Cleared when an agreement is created.
   */
  captureSuppressedReason String?
  captureSuppressedAt     DateTime?
  createdAt            DateTime @default(now())

  decisions ReconciliationDecision[]

  @@unique([practiceId, pmsInvoiceKey])
  @@index([practiceId])
  @@index([serviceDate])
  @@map("service_records")
}

/**
 * FR-7.3 — convert-or-forgo. A service was billed, the patient was seen, and
 * no agreement was captured; a PERSON decides what happens to the benefit:
 * bill privately, write it off, or keep trying. "Choose explicitly. Nothing
 * happens by default, and either choice is recorded." (design, R-3).
 *
 * APPEND-ONLY. A decision is not edited or deleted; a later one supersedes
 * it, with its own reason and its own name. The database refuses UPDATE and
 * DELETE the way it does for signature events.
 */
model ReconciliationDecision {
  id              String        @id @default(uuid()) @db.Uuid
  practiceId      String        @db.Uuid
  serviceRecordId String        @db.Uuid
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  /// convert_to_private | forgo_benefit | keep_chasing
  decision  String
  reason    String?
  /// The deciding person, from their session. Never free text.
  decidedBy String
  decidedAt DateTime @default(now())

  @@index([practiceId, serviceRecordId, decidedAt])
  @@map("reconciliation_decisions")
}

/**
 * What a PERSON at the practice did to chase an agreement — rang the patient,
 * texted them, caught them at the desk, put a letter in the post — and what
 * came of it.
 *
 * Carl, 3 Sep 2026: "we need an audit-trail to show that a practice-user
 * called the Patient, sent SMS / email and so on ... The Practice will chase
 * as they will not get paid otherwise." The platform's own attempts are
 * already evidence (capture requests, correspondence rows); this is the half
 * that happens off the platform, and it is the half a practice needs when
 * somebody asks why an item was closed unbilled.
 *
 * NO IDENTIFIER VALUES (REQ-VER-04): the row says which KIND of contact was
 * used and WHO was contacted by role — never the number, never the address.
 * No dollar amount anywhere (rule 4).
 *
 * SUBJECT IS ServiceRecord OR Agreement, ENFORCED BY A CHECK CONSTRAINT. A
 * reg 89AA notice is never chased (rule 7, REQ-CHASE-02, REQ-END-05), so
 * "Notice" is not a value the column will take.
 *
 * APPEND-ONLY, like reconciliation_decisions: a correction is a new row
 * pointing at the one it replaces. The database refuses UPDATE and DELETE,
 * and the runtime role does not hold either privilege on this table.
 */
model ChaseAttempt {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid

  /// ServiceRecord | Agreement. Never Notice — see the CHECK constraint.
  subjectType String
  subjectId   String @db.Uuid

  /// phone | sms | email | in_person | post
  channel String
  /// reached | no_answer | left_message | refused | wrong_contact
  outcome String
  /// patient | assignor | other — a ROLE, never a name (REQ-VER-04).
  contactedPartyType String?
  /// What was said. Never a number, an address or an amount.
  note String?

  /// The person, from their session. Never from the request body.
  attemptedBy   String
  /// Their realm subject — the thing to join on when a display name changes.
  attemptedById String

  /// When the contact happened, which may be before it was written down.
  occurredAt DateTime @default(now())
  recordedAt DateTime @default(now())

  /// What the ladder said at the time (REQ-CHASE-05) — evidence of the rule, not just the act.
  band           String
  daysRemaining  Int
  attemptOrdinal Int

  /// A correction points at the row it replaces. One correction per row.
  supersedesId String?       @unique @db.Uuid
  supersedes   ChaseAttempt? @relation("ChaseAttemptCorrection", fields: [supersedesId], references: [id])
  supersededBy ChaseAttempt? @relation("ChaseAttemptCorrection")

  @@index([practiceId, subjectType, subjectId, occurredAt])
  @@map("chase_attempts")
}

/**
 * A PRACTICE'S PAIRED TABLET — the one credential the zero-footprint rule
 * allows on a device (CLAUDE.md §7, TODO.md "Zero-footprint kiosk").
 *
 * Like a payment terminal paired to a merchant: the console registers a device
 * and shows a short-lived code, somebody types it into the tablet once, and
 * the tablet keeps an opaque credential from then on. `/kiosk` no longer takes
 * a practice id from anybody — the server resolves the practice from the
 * credential, and RLS re-checks it exactly as before.
 *
 * ONLY THE HASH IS STORED (the spirit of REQ-VER-04, and the same rule
 * `capture_requests.tokenHash` already keeps): a database read cannot mint a
 * working credential, and a credential cannot be recovered for somebody who
 * lost it — rotate issues a new one.
 *
 * REVOKE AND ROTATE ARE CONSOLE ACTS, never device acts. A tablet that can
 * un-pair itself is a tablet a passer-by can un-pair.
 */
model Device {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid

  /// What a human calls it, in a list a human reads. "Reception tablet 1".
  label String

  /// sha256 of the credential's secret half. NEVER the credential itself.
  /// Null before the first pairing, and again after a revoke or a rotate —
  /// the credential on the device stops resolving the moment this clears.
  credentialHash String? @unique

  /// The person who registered it, from their session. Never from the body.
  createdBy   String
  createdById String
  createdAt   DateTime @default(now())

  pairedAt DateTime?

  /// Updated at most once a minute, not on every two-second poll — a heartbeat
  /// that wrote on every request would turn a quiet waiting room into a write
  /// per tablet per two seconds, for a column a person reads once a fortnight.
  lastSeenAt DateTime?

  /// What the tablet last said it was running, so support can read it back
  /// without asking somebody to look at the device.
  lastKioskBuild String?

  revokedAt   DateTime?
  revokedBy   String?
  /// Why. A device taken out of service and one lost in a taxi are different
  /// stories, and only one of them is a security event.
  revokedReason String?

  /// A TEST DEVICE — the ONLY kind that is shown the waiting list (Carl, 4 Sep
  /// 2026: "the list page is only for testing purposes").
  ///
  /// The walk-up tablet must never display other patients' names, so Begin
  /// goes straight to "Confirm your details" and the server finds the one
  /// waiting row that matches. `GET /kiosk/waiting-list` answers a device
  /// without this flag `{ waiting: [], hidden: true }` — and no count either,
  /// because the count was itself the disclosure Carl removed.
  ///
  /// SET FROM THE CONSOLE, NEVER FROM THE TABLET (`PATCH /devices/:id`), for
  /// the same reason revoke lives there: a device that can turn its own
  /// disclosure on is a device a passer-by can turn on. Default false.
  showsWaitingList Boolean @default(false)

  @@index([practiceId])
  @@map("devices")
}

/**
 * THE SHORT-LIVED CODE, in its own table and deliberately NOT practice-scoped
 * by RLS — for the same reason `vault_outbox` is not.
 *
 * `POST /devices/pair` is reached by a tablet that has no practice scope yet;
 * establishing one is the entire point of the call. A policy on
 * `app.practice_id` would fail closed against the one caller the row exists
 * for. So the lookup is by hash on a table that carries no patient data at
 * all — a hash, an expiry and two ids — and the FIRST thing the service does
 * with the practice it finds is re-enter `withPractice` for every subsequent
 * read and write.
 *
 * SINGLE USE IS ENFORCED BY THE UPDATE, not by a read-then-write: consuming a
 * code is `updateMany` on `consumedAt IS NULL`, so two tablets racing on the
 * same code produce one credential and one refusal.
 */
model DevicePairingCode {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid
  deviceId   String @db.Uuid

  /// sha256 of the normalised code. The code itself is shown once, on the
  /// console screen that created it, and is never stored or re-displayed.
  codeHash String @unique

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([deviceId])
  @@index([expiresAt])
  @@map("device_pairing_codes")
}

/**
 * ONE LOCKED AGREEMENT, ASSIGNED TO ONE NAMED TABLET (TODO.md "Push-to-device
 * capture" / "Two front doors", Carl 4 Sep 2026).
 *
 * WHAT A ROW MEANS. Reception has checked the Medicare card in the PMS,
 * matched the patient, and asked date of birth, mobile, email and address
 * across the desk — the three-identifier staff check (REQ-VER-03). The push
 * then validates and LOCKS the particulars server-side and hands the result to
 * the tablet beside them, so a draft can never reach a device (REQ-REG-06).
 * The row is the handle both halves hold: the tablet polls for it, the console
 * watches its state, and recall ends it.
 *
 * ONE SESSION PER DEVICE IS A PARTIAL UNIQUE INDEX, not a check in a service.
 * `tablet_sessions_one_active_per_device` is UNIQUE on `deviceId` WHERE
 * `endedAt IS NULL`. Two receptionists pushing to the same tablet in the same
 * second produce one session and one refusal, and the refusal carries the
 * live session's id so the console can offer Recall. A read-then-write would
 * produce two sessions and a screen nobody could explain.
 *
 * IT HOLDS NO PATIENT DATA. Ids, a state, a staff name and timestamps. The
 * particulars live on the agreement, where they are locked and hashed; the
 * person's details are read live from `patients` for the one screen that shows
 * them and are never copied here.
 *
 * ENDING A SESSION NEVER TOUCHES THE AGREEMENT. Walked away, recalled and
 * expired all leave the agreement exactly as the push left it — the platform
 * never blocks care (REQ-REC-04), and a patient who declines a screen is still
 * seen and still billable by another route.
 */
model TabletSession {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid
  deviceId   String @db.Uuid

  agreementId String @db.Uuid

  /// The `in_practice` capture request this session signs against. Opened by
  /// the push where the agreement had none, so the tablet passes it straight
  /// back to the EXISTING `POST /agreements/:id/sign`.
  captureRequestId String? @db.Uuid

  /// The staff-verified event the push recorded. TYPES and an outcome, never
  /// values (REQ-VER-04) — the event itself lives in `verification_events`.
  verificationEventId String? @db.Uuid

  /// pushed | reading | details_confirmed | signed | walked_away | recalled | expired
  state String @default("pushed")

  /// WHICH DETAILS THE PATIENT TICKED AS CORRECT — TYPES ONLY, and it is not a
  /// verification (REQ-VER-03/-04). `mobile` and `email` appear here and are
  /// CONTACT details, never identity identifiers (REQ-VER-02).
  detailsConfirmedTypes String[] @default([])
  detailsConfirmedAt    DateTime?

  /// Who pushed it, from their verified session — never from the body. The
  /// same act is the verification record, so an unattributed push is refused.
  pushedBy   String
  pushedById String
  pushedAt   DateTime @default(now())

  /// Moves on every state change; the thirty-minute idle expiry measures from
  /// here rather than from `pushedAt`, so a patient part-way through a long
  /// read is not thrown off the screen.
  lastStateAt DateTime @default(now())

  /// Set exactly once, when the session ends. NULL is what makes it active,
  /// and what the partial unique index keys on.
  endedAt DateTime?

  @@index([practiceId])
  @@index([deviceId])
  @@index([agreementId])
  @@map("tablet_sessions")
}

// FR-11.2 — the vault outbox. Rows are inserted in the SAME transaction as
// the domain write they evidence; the relay publishes them to the Evidence
// Vault with backoff and no permanent give-up (packages/vault-client).
// Deliberately NOT practice-scoped by RLS: the relay runs as a system job
// across all practices, and rows carry IDs only, never content (REQ-LOG-08).
model VaultOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  actor         Json
  subjectType   String
  subjectId     String
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime?

  @@index([publishedAt, nextAttemptAt])
  @@map("vault_outbox")
}

/**
 * The outbound queue — TRANSPORT, not evidence.
 *
 * `Notice` and `NoticeDeliveryEvent` remain the delivery record (REQ-DEL-01).
 * This table carries a payload to a destination and records attempts. The
 * distinction is what makes this table PRUNABLE: once an item is sent and the
 * evidence layer has been told, the row has no further job, while the notice
 * it carried must survive two years.
 *
 * That matters at the modelled volume. 750,000 notices a day is 274 million
 * rows a year — fine as a working queue that is pruned, ruinous as a permanent
 * one.
 *
 * WHY POSTGRES RATHER THAN A BROKER. The enqueue happens in the SAME
 * TRANSACTION as the evidence write, which makes two failures impossible: a
 * notice with no send, and a send with no notice. Any out-of-process broker
 * reintroduces both and then needs an outbox to fix them — which is this
 * table. `FOR UPDATE SKIP LOCKED` handles the ~21/second average and its peaks
 * without breathing hard.
 */
model OutboundItem {
  id         String  @id @default(uuid()) @db.Uuid
  /// NULL is legal for exactly one shape: a message about a practitioner's
  /// own identity, addressed to them, with no practice to anchor it to (see
  /// migration 20260824050000). A CHECK constraint enforces that this is the
  /// only case NULL is allowed in -- never a practice message left blank.
  practiceId String? @db.Uuid

  /// email | sms | webhook | device
  channel String
  /**
   * Where it goes. NULL is legal only for `device`: a kiosk item is addressed
   * to whichever tablet at that practice comes for it, and demanding a device
   * id up front would mean knowing which screen a patient will walk up to.
   */
  destination String?

  /// What this is about, so the evidence layer can be told what happened.
  subjectType String
  subjectId   String @db.Uuid

  /**
   * The body. JSON so a kiosk payload, an email envelope and a webhook body
   * share one table. Capped in the domain at 256KB — large content belongs in
   * the artefact store with a reference queued instead, because this table
   * shares a database with the consent records.
   */
  payload Json

  /**
   * WHAT IT IS, as distinct from how it travels.
   *
   * email | json | xml | pdf | markdown. `channel` says how it gets there;
   * this says what the recipient opens. A JSON document can go by webhook or
   * wait for a kiosk, and the viewer that renders it depends on this, not on
   * the channel.
   */
  mediaType String @default("email")

  // --- WHERE and WHO, so a support call is answerable ---
  //
  // "Dr Sorrell never got the notice about the Yagoona site" has to be
  // answerable by filtering, because the alternative is opening payloads one
  // at a time — and payloads are the one thing we deliberately do not let
  // anybody search, since a body search would let somebody trawl for a
  // patient name across a practice.
  locationId   String? @db.Uuid
  departmentId String? @db.Uuid

  /// practitioner | patient | assignor | practice | other
  recipientType String?
  recipientId   String? @db.Uuid
  /**
   * DENORMALISED, and correctly so. A support call is answered by typing a
   * name, and resolving one through three joins on a table gaining 274
   * million rows a year is not a query anybody should run. It is also the
   * right evidence: this is the name the message was ADDRESSED to at the
   * time, which is not necessarily the name that record carries today.
   */
  recipientName String?

  // --- Resending ---
  //
  // A resend is a NEW ROW, not a mutated one. A counter alone would tell you
  // it went three times; the copies tell you when each went, who asked, and
  // what the provider said — which is what a support call actually needs.
  // The count is kept as well so a list can show "sent 3 times" without a
  // subquery per row.
  /// The original. NULL on an original.
  resendOfId   String? @db.Uuid
  /// On the ORIGINAL: how many times it has been sent again.
  resendCount  Int     @default(0)
  /// The KEY, from `resend_reasons`. Countable — "how often do our messages
  /// not arrive" is a question about deliverability, and free text cannot
  /// answer it.
  resendReason String?
  reason       ResendReason? @relation(fields: [resendReason], references: [key])
  /// The WORDS. What makes one resend accountable rather than countable. At
  /// least three of them; the rule is in the domain.
  resendNote   String?
  /// Who asked, from the verified token.
  resendByName String?

  /// Set when the payload points at a stored file rather than carrying it.
  artefactId String? @db.Uuid

  /// pending | leased | sent | failed | dead
  state    String @default("pending")
  attempts Int    @default(0)

  /// When it may next be attempted. Drives both scheduling and backoff.
  availableAt DateTime @default(now())

  /**
   * Who holds it, and until when. A lease that expires IS the recovery
   * mechanism for a worker that died — nothing has to detect the death, the
   * lease simply stops being true.
   */
  leasedBy       String?
  leaseExpiresAt DateTime?

  /**
   * One logical send. Built from what the send IS, never from a timestamp, so
   * a retry after a crash produces the same key and cannot become a duplicate.
   * Re-sending a statutory notice is not a duplicate email — it is a second
   * assertion that notice was given.
   */
  idempotencyKey String

  lastError   String?
  /// Set when the provider gave us an id we can reconcile against later.
  providerRef String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([practiceId, idempotencyKey])
  @@index([practiceId])
  @@map("outbound_items")
}

/**
 * Work arriving FROM a practice's desktop: a print job, already parsed down to
 * the s 65C fields (CONSULTATION-CAPTURE-PLAN.md Parts 8 and 9).
 *
 * THE MIRROR IMAGE OF `outbound_items`, and built the same way on purpose:
 * the same states, the same lease, the same backoff and attempt budget from
 * `outbound-queue.ts`, the same "dead is kept, never deleted". What it adds is
 * the LANE — critical / standard / fyi — declared per document type in
 * `inbound-lanes.ts`, with one worker per lane so the morning appointment list
 * can never sit in front of the patient standing at the desk.
 *
 * The payload is a `PrintJobEnvelope` (contracts/print-capture.ts): patients,
 * providers, appointments, invoices in adapter shape. Never the document.
 */
model InboundPrintJob {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid

  /**
   * Which desktop (8.5), once devices enrol. NULL until then — the request is
   * practice-scoped like every other, and `credentialKind` says which model
   * authenticated it so attribution is never ambiguous about what it rests on
   * (Part 6 Q9: device key AND shared practice key are both allowed).
   */
  deviceId       String?
  credentialKind String  @default("practice") // device | practice

  documentType          String
  lane                  String
  pms                   String
  parserTemplateVersion String
  /// SHA-256 of the source print job. Provenance without possession (8.2).
  sourceSha256          String

  payload Json

  state          String    @default("pending") // pending | leased | done | failed | dead
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  leasedBy       String?
  leaseExpiresAt DateTime?
  lastError      String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// What processing produced — captured / suppressed tallies — so "what did
  /// that print job do" is answerable from the row.
  outcome     Json?

  /// The same document printed twice is the same job. Same type, same bytes.
  @@unique([practiceId, documentType, sourceSha256])
  @@index([practiceId, lane, state])
  @@map("inbound_print_jobs")
}

/**
 * What was sent, as EVIDENCE — CONSULTATION-CAPTURE-PLAN.md Part 4.
 *
 * Two stores existed and neither fits. `outbound_items` is transport: it
 * answers "did it leave, is it stuck" and is pruned after thirty days, so a
 * patient or practitioner looking at it would watch their own history vanish.
 * `Notice` is durable but is specifically the reg 89AA notice, with its claim
 * reference and 24-hour clock. The pending-email confirmations, the acting-as
 * notices, the invitations, the capture links — none is a Notice, and all of
 * them are what a practice, a doctor and a patient must be able to see for
 * the retention period.
 *
 * So: the evidence twin of every transport row, written in the same
 * transaction as the send, kept for `retentionExpiryDate`, and — when that
 * day comes — TOMBSTONED, not deleted: the text goes, the fact that a message
 * was sent, to whom, about what, stays (`contentRemovedAt`). `legalHold` wins.
 *
 * NOT a rewrite of Notice: the 89AA notice keeps its statutory shape and also
 * writes a row here, so one screen can show everything.
 */
model Correspondence {
  id String @id @default(uuid()) @db.Uuid

  /**
   * NULL for exactly one shape, the same one as outbound_items: a message
   * about a practitioner's own identity, addressed to them, with no practice
   * to anchor it to. The CHECK constraint enforces that this is the only case.
   */
  practiceId String? @db.Uuid

  /// practice | practitioner | patient | assignor — who it was for.
  recipientType String?
  /// The PERSON, never only the address, so a changed address does not orphan history.
  recipientId   String? @db.Uuid
  recipientName String?
  /// The address at the time. NULL for a kiosk (`device`) item, which is addressed to a screen.
  to String?

  channel   String
  mediaType String @default("email")

  subject  String?
  bodyText String?
  bodyHtml String?
  /// Who composed it: aobplatform | keycloak | a named person at the practice.
  sentBy String?

  /// What it was about — Agreement, CaptureRequest, PendingEmailChange, ActingAsSession, Notice, Practitioner …
  subjectType String
  subjectId   String @db.Uuid

  /// The transport row it mirrors, while that row still exists. Unique: one evidence row per send.
  outboundItemId String? @unique @db.Uuid
  /// The 89AA notice it mirrors. Unique for the same reason.
  noticeId String? @unique @db.Uuid

  /// queued | sent | delivered | failed | dead — a projection of the transport's states, kept after the transport is pruned.
  state         String    @default("queued")
  queuedAt      DateTime  @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  // --- Part 5: retention, soft ---
  retentionExpiryDate DateTime? @db.Date
  legalHold           Boolean   @default(false)
  /// Set by the retention sweep when the text was removed. The row stays.
  contentRemovedAt DateTime?

  @@index([practiceId, queuedAt])
  @@index([recipientType, recipientId, queuedAt])
  @@index([subjectType, subjectId])
  @@index([retentionExpiryDate])
  @@map("correspondence")
}

/**
 * A platform operator acting as a practice.
 *
 * NO RLS, deliberately — the one table where that is correct. A session
 * belongs to the PLATFORM, not to the practice being acted for, and the
 * separation-of-duties check reads across practices. Nothing here is patient
 * data; it is who did what, which is the opposite of a thing to hide.
 *
 * APPEND-ONLY, enforced by triggers rather than convention: this is the record
 * of impersonation, so it is precisely the table somebody would want to edit
 * their way out of. Deletes are refused outright, and who/for whom/why/when
 * cannot be changed after the fact.
 */
model ActingAsSession {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid

  /// The REAL person, from the verified token. Never the practice.
  operatorSub  String
  operatorName String

  /// From ACTING_AS_REASONS. Chosen, so "how often, and why" is answerable.
  reason String
  note   String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  /// expired | ended_by_operator. A session that always expires is somebody
  /// who never closes them, which is worth being able to see.
  endedHow  String?

  /// Rule 3: no OTP before, notified after. This is the proof the after happened.
  practiceNotifiedAt DateTime?

  /// Rule 6: impersonation forces re-approval. Cleared when somebody OTHER
  /// than the operator approves — see assertMayApproveAfterActingAs.
  forcedReapproval  Boolean @default(true)
  clearedByApproval String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([operatorSub, startedAt])
  @@index([practiceId, startedAt])
  @@map("acting_as_sessions")
}

/**
 * Work arriving INTO the platform that needs a second look.
 *
 * Separate from OutboundItem on purpose: that carries things LEAVING, this
 * carries work coming in. One table would mean "queue" meaning two things in
 * one schema.
 *
 * THE TASK IS NOT THE EVIDENCE. The amendment record already holds what
 * changed, who changed it and why. What IS evidence is the RESOLUTION —
 * "somebody looked at this and accepted it" — and that goes to the vault, so a
 * task row can be pruned while the decision cannot.
 */
model ReviewTask {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid

  /// From REVIEW_TASK_KINDS. The kind carries the stakes, and the stakes
  /// decide whether an automated check may close it.
  kind        String
  subjectType String
  subjectId   String @db.Uuid

  /// What a reviewer reads first. Written when the task is raised, because
  /// the raiser knows what changed and a reviewer opening it later should not
  /// have to reconstruct it.
  summary String
  detail  Json   @default("{}")

  state    String   @default("open")
  raisedBy String
  raisedAt DateTime @default(now())

  /// Leasing, so a person and a checker cannot both work the same task.
  claimedBy      String?
  claimExpiresAt DateTime?

  /// What an automated check thought. ADVICE, recorded whether or not it was
  /// allowed to act on it — a model that flagged something a person then
  /// dismissed is worth being able to find later.
  autoVerdict    String?
  autoConfidence Float?
  autoReasoning  String?
  autoCheckedBy  String?
  autoCheckedAt  DateTime?

  resolution   String?
  resolvedBy   String?
  resolvedAt   DateTime?
  resolvedNote String?
  /// TRUE when no person looked. Its own column rather than inferred from
  /// resolvedBy, because "was this reviewed by a human" is a question somebody
  /// will ask of the whole table at once.
  resolvedAutomatically Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([practiceId, raisedAt])
  @@index([kind, raisedAt])
  @@map("review_tasks")
}

/// A change to the administrator's email address, held until it is confirmed.
///
/// The rules are in `@aobplatform/domain/pending-email-change` and the reasons
/// are in the migration. The short version: changing this address redirects the
/// channel by which a practice finds out anything -- including that its address
/// was redirected -- so it is proved before it takes effect, and BOTH ends are
/// told while it waits.
model PendingEmailChange {
  id String @id @default(uuid()) @db.Uuid

  /**
   * EXACTLY ONE SUBJECT. This table was built for a practice's administrator
   * address, so `practiceId` was the anchor. A practitioner has no practice —
   * their scope is their affiliations — so theirs cannot hang off it.
   *
   * Rather than a second table repeating token, code, expiry and outcome, the
   * change gains a subject: a practice or a practitioner, never both and never
   * neither. `num_nonnulls(...) = 1` in the database says so; nullable columns
   * alone would allow a row belonging to nobody.
   */
  practiceId     String? @db.Uuid
  practitionerId String? @db.Uuid

  /// WHICH ADDRESS ON THE PRACTICE. adminEmail or groupEmail — practitioner
  /// rows have no second field to name, so this stays 'adminEmail' for them by
  /// convention rather than meaning anything there. The one-live-request index
  /// is keyed on this too, so a practice can hold a live adminEmail change and
  /// a live groupEmail change at once without either superseding the other.
  field String @default("adminEmail")

  requestedEmail String
  /// What THE FIELD NAMED ABOVE was AT THE TIME — the previous adminEmail when
  /// `field` is adminEmail, the previous groupEmail when it is groupEmail.
  /// `practices` moves on; a reviewer reading history needs the value this
  /// request was actually about.
  previousEmail  String?
  /// The WITNESS for an adminEmail change: the group address BEFORE the save.
  /// If the group address is changed in the same save, the warning must still
  /// go where the practice could read it.
  previousGroupEmail String?
  /// The WITNESS for a groupEmail change: the admin address at the time, told
  /// what the practice's shared inbox is becoming. groupEmail has no sign-in
  /// of its own to protect, so there is no handover here — only a second
  /// channel to notice the change.
  previousAdminEmail String?

  requestedAt     DateTime @default(now())
  requestedByName String
  expiresAt       DateTime

  /// The link carries the token; the human carries the code. A link alone is
  /// consumed by a GET, and mail scanners issue GETs.
  confirmToken String  @unique
  confirmCode  String
  attempts     Int     @default(0)

  /// Separate from confirmToken, so holding one never implies the other:
  /// whoever can confirm the change must not thereby be able to cancel the
  /// warning about it.
  stopToken String @unique

  /// NULL while waiting. confirmed | stopped | expired | superseded.
  outcome   String?
  outcomeAt DateTime?
  /// The ADDRESS that answered, never free text from whoever answered it.
  outcomeBy String?

  /// The backup address AT THE TIME, so a reviewer can see which channel was
  /// actually reachable rather than assuming the old one was.
  backupEmail String?

  /// When it took effect. The cooling-off window runs from HERE, not from the
  /// request: somebody who notices late is objecting to the change having
  /// happened, not to it having been asked for.
  effectiveAt DateTime?

  createdAt DateTime @default(now())

  @@index([practiceId, requestedAt])
  @@index([practitionerId, requestedAt])
  @@map("pending_email_changes")
}

/// The common reasons for sending a message again, as DATA.
///
/// A table rather than a list in the code, because somebody will think of a
/// sixth one and that should not be a code change, a review and a deploy. A
/// catalogue of common answers changes at the speed of operations.
///
/// What deliberately did NOT move here is the rule about how much somebody has
/// to say — `MIN_RESEND_REASON_WORDS` stays in the domain, because a rule
/// living in this table could be edited to nothing by whoever was tired of
/// typing.
///
/// Not row-level scoped: a catalogue of words, identical for every practice and
/// containing nothing about anybody. Scoping it would give each practice its
/// own list, which is the opposite of what makes the answers countable.
model ResendReason {
  /// Stable, and referenced by outboundItems.resendReason. Renaming a label
  /// must never orphan the records that chose it.
  key       String   @id
  label     String
  detail    String
  /// Retired rather than deleted: deleting one orphans every record that chose
  /// it, and "why did we resend these forty" stops having an answer.
  active    Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())

  outboundItems OutboundItem[]

  @@map("resend_reasons")
}
