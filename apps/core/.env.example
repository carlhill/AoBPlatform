# Core application — copy to .env for local dev (never commit .env).
PORT=3001
# Runtime connects as the NON-SUPERUSER app role — a superuser bypasses RLS
# and silently disables practice scoping. Migrations use ADMIN_DATABASE_URL:
#   $env:DATABASE_URL = "<ADMIN_DATABASE_URL>"; npm run prisma:migrate -w apps/core
DATABASE_URL=postgresql://aob_app:aob_app@localhost:21020/aobplatform?schema=core
ADMIN_DATABASE_URL=postgresql://aobplatform:aobplatform@localhost:21020/aobplatform?schema=core
REDIS_URL=redis://localhost:21021
RULES_SERVICE_URL=http://localhost:3002
VAULT_SERVICE_URL=http://localhost:3003
# Keycloak (OIDC, WebAuthn passkeys mandatory for provider/admin roles — rule 15)
KEYCLOAK_ISSUER=http://localhost:21024/realms/aobplatform
KEYCLOAK_CLIENT_ID=core
KEYCLOAK_CLIENT_SECRET=change-me-in-local-env
# Messaging: sandbox gateway only in dev — real sends require a registered
# sender and cost money; ask Carl before wiring anything real (CLAUDE.md §7).
SMS_GATEWAY_MODE=sandbox
SMTP_HOST=localhost
SMTP_PORT=21025
