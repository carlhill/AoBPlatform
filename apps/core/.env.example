# Core application — copy to .env for local dev (never commit .env).
#
# 127.0.0.1 EVERYWHERE, never `127.0.0.1`.
#
# On Windows, `127.0.0.1` resolves to ::1 first. Docker Desktop publishes a port
# on both stacks, but its IPv6 forwarding accepts the TCP connection and then
# fails the protocol handshake — so a raw socket test reports the port OPEN
# while Prisma reports "can't reach database server", and an SMTP send hangs
# until it times out rather than refusing.
#
# The symptom is the worst kind: everything looks up, and only the things that
# speak a protocol fail. An afternoon went into this on a day the database was
# running perfectly throughout.
PORT=3001
# Runtime connects as the NON-SUPERUSER app role — a superuser bypasses RLS
# and silently disables practice scoping. Migrations use ADMIN_DATABASE_URL:
#   $env:DATABASE_URL = "<ADMIN_DATABASE_URL>"; npm run prisma:migrate -w apps/core
DATABASE_URL=postgresql://aob_app:aob_app@127.0.0.1:21020/aobplatform?schema=core
ADMIN_DATABASE_URL=postgresql://aobplatform:aobplatform@127.0.0.1:21020/aobplatform?schema=core
REDIS_URL=redis://127.0.0.1:21021
# The docker-compose containers publish on 21002/21003 (3002/3003 are the ports
# INSIDE the containers). Pointing core at 3002 makes every particulars lock a
# 500 -- "fetch failed, ECONNREFUSED" -- with no other symptom (3 Sep 2026).
RULES_SERVICE_URL=http://127.0.0.1:21002
VAULT_SERVICE_URL=http://127.0.0.1:21003
# Keycloak (OIDC, WebAuthn passkeys mandatory for provider/admin roles — rule 15)
#
# THREE URLS, AND THEY ARE NOT INTERCHANGEABLE. Getting this wrong produces a
# 401 with "unexpected iss claim value" on every browser-issued token, and it
# stays invisible until something actually verifies one.
#
#   KEYCLOAK_PUBLIC_ISSUER  what the token's `iss` claim SAYS. Minted from the
#                           URL THE BROWSER used, so it must be `localhost` —
#                           it is compared as a string and never fetched.
#   KEYCLOAK_JWKS_URI       where WE fetch the signing keys. Server-to-server,
#                           so `127.0.0.1` (see the ::1 note at the top).
#   KEYCLOAK_ISSUER         where WE mint service tokens, client-credentials,
#                           server-to-server. Also `127.0.0.1`.
#
# docker-compose.yml has had all three right since the containers were set up.
# This file did not, because it was written when core ran in Docker and nothing
# here verified a token yet.
KEYCLOAK_PUBLIC_ISSUER=http://localhost:21024/realms/aobplatform
KEYCLOAK_JWKS_URI=http://127.0.0.1:21024/realms/aobplatform/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://127.0.0.1:21024/realms/aobplatform
# The client that actually exists in the realm is `core-service`. `core`
# named nothing, so any service-token mint would have failed the first time
# it was tried -- and it is also the id our own `aud` must contain.
KEYCLOAK_CLIENT_ID=core-service
KEYCLOAK_CLIENT_SECRET=change-me-in-local-env
# Messaging: sandbox gateway only in dev — real sends require a registered
# sender and cost money; ask Carl before wiring anything real (CLAUDE.md §7).
SMS_GATEWAY_MODE=sandbox
SMTP_HOST=127.0.0.1
SMTP_PORT=21025

# URLs THE BROWSER FOLLOWS. `localhost`, not 127.0.0.1 — these end up in emails
# and in OAuth redirect_uri parameters, and a redirect_uri is validated as a
# STRING against the client's registered list. 127.0.0.1:3100 is not on it, and
# Keycloak answers a mismatch with a bare `400 Invalid redirect uri`.
APPLICATION_STATUS_BASE_URL=http://localhost:3100
CONSOLE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# FR-8.2 — PATIENT PORTAL PASSKEYS (Carl, 4 Sep 2026; D-2026-09-04-02)
#
# A WebAuthn credential is bound to PORTAL_RP_ID at the moment it is created and
# can never be moved. Enrol a patient against `localhost` and that credential is
# useless on a real host forever, so these are per-environment values with local
# defaults and no safe production guess.
#
#   PORTAL_RP_ID   the DOMAIN the credential is scoped to. No scheme, no port,
#                  no path. Must be the origin's host or a registrable suffix of
#                  it, or the browser refuses to create the credential at all.
#   PORTAL_ORIGIN  the full origin THE BROWSER IS ON — this is the WEB app
#                  (3100), not core (3001). The ceremony happens on the page;
#                  core only checks what the browser reported. Comma-separate to
#                  allow more than one host. Never a wildcard: an RP that accepts
#                  any origin accepts a phishing page's origin.
#   PORTAL_RP_NAME what the passkey manager shows the patient when it asks for
#                  their face, fingerprint or PIN. The one value here a person
#                  ever reads.
PORTAL_RP_ID=localhost
PORTAL_ORIGIN=http://localhost:3100
PORTAL_RP_NAME=AoBPlatform — your bulk-billing record

# Browser origins allowed to call core with credentials (the patient portal cookie).
# Comma-separated; never a wildcard.
CORS_ORIGINS=http://localhost:3100
