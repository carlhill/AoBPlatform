# Evidence Vault service — copy to .env for local dev (never commit .env).
# Separate trust domain (REQ-LOG-05): own credentials, own stores. No delete
# grants exist in any application role.
PORT=3003
# Relational bookkeeping only (verification-request metadata etc.) — the
# actual tamper-evident events live in immudb.
DATABASE_URL=postgresql://aobplatform:aobplatform@localhost:21020/aobplatform?schema=vault
IMMUDB_HOST=localhost
IMMUDB_PORT=21022
IMMUDB_USER=immudb
IMMUDB_PASSWORD=change-me-in-local-env
IMMUDB_DATABASE=aobvault
# RFC 3161 timestamp authority for chain-head anchoring (REQ-VAULT-03) — not
# wired in dev; the anchoring job no-ops when unset.
RFC3161_TSA_URL=
