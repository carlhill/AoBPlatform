# Evidence Vault service — copy to .env for local dev (never commit .env).
# Separate trust domain (REQ-LOG-05): own credentials, own stores. No delete
# grants exist in any application role.
PORT=3003
# memory = DEV-ONLY reference store (not tamper-evident at rest, lost on
# restart). immudb = the durable store (index in Postgres, evidence in
# immudb; DRAFT implementation pending Carl's review).
CHAIN_STORE=immudb
IMMUDB_NAMESPACE=aobvault
# immudb-node persists local Merkle root state here — machine-local, gitignored.
IMMUDB_STATE_PATH=.immudb-state/root
# Chain-entry INDEX only (locator rows) — the evidence lives in immudb.
VAULT_DATABASE_URL=postgresql://aob_app:aob_app@localhost:21020/aobplatform?schema=vault
IMMUDB_HOST=localhost
IMMUDB_PORT=21022
IMMUDB_USER=immudb
# immudb 1.1.0 container default credentials — local dev only.
IMMUDB_PASSWORD=immudb
IMMUDB_DATABASE=aobvault
# RFC 3161 timestamp authority for chain-head anchoring (REQ-VAULT-03) — not
# wired in dev; the anchoring job no-ops when unset.
RFC3161_TSA_URL=
