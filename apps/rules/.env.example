# Rules & Conformance service — copy to .env for local dev (never commit .env).
# This service holds ZERO PII (ADR A-07): no patient database, no identifier
# values in any log. Rule sets and mappings are versioned content artefacts.
PORT=3002
# Content store for versioned rule sets + Basic Service Description mappings.
DATABASE_URL=postgresql://aobplatform:aobplatform@localhost:21020/aobplatform?schema=rules
REDIS_URL=redis://localhost:21021
