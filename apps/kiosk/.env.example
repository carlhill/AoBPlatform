# Kiosk configuration. Copy to `.env` for local dev; never commit `.env`.
#
# EXPO_PUBLIC_* variables are INLINED INTO THE BUNDLE at build time. Nothing
# secret may ever go in one — there is no secret here by design: the practice
# id is a scope hint that RLS re-checks, and the staff id is an attribution
# stand-in until the passkey session lands.

# apps/core.
EXPO_PUBLIC_CORE_URL=http://localhost:3001

# Dev stand-in for the practice claim on the signed-in staff session
# (Part 6 decision 3). RLS means a wrong or absent id yields nothing.
EXPO_PUBLIC_PRACTICE_ID=

# Dev stand-in for `verifiedByStaffId` on the verification event.
EXPO_PUBLIC_STAFF_ID=
