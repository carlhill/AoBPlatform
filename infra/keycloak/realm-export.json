          "autheticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "clinician-browser Credential"
        }
      ]
    },
    {
      "alias": "clinician-browser Credential",
      "description": "Passkey, or password as a first-login bootstrap. Both ALTERNATIVE: Keycloak only offers a branch the user holds a credential for, so keeping clinicians password-less after enrolment is what enforces passkey-only login.",
