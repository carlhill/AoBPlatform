.terraform.lock.hcl

# immudb / postgres local data volumes (bind-mounted, not committed)
infra/data/

# OneDrive noise
~$*

# Vault's workspace-local Prisma client (generated)
apps/vault/prisma-client/

# immudb-node client Merkle state (machine-local)
.immudb-state/
root
apps/web/.env.local
.artefacts/

# Database backups. NEVER COMMITTED — a Keycloak dump names every administrator
# you have and holds the public half of every passkey. It is a map of the
# identity system, and a repository is the wrong place to keep one.
backups/
*.sql.gz

# Playwright output for the kiosk ceremony spec (apps/web/e2e). Artefacts of a
# run, never source: traces, screenshots and the HTML report.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
