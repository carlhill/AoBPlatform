{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@aobplatform/domain": ["../../packages/domain/src"],
      "@aobplatform/contracts": ["../../packages/contracts/src"],
      "@aobplatform/vault-client": ["../../packages/vault-client/src"],
      "@aobplatform/connector": ["../../apps/connector/src"],
      "@aobplatform/auth-client": ["../../packages/auth-client/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}
